rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Iniciativas: qualquer usuário autenticado lê; escrita exige auth
    match /initiatives/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Perfis de usuário: autenticados leem e escrevem
    match /users/{uid} {
      allow read, write: if request.auth != null;
    }

    // Solicitações de acesso: qualquer um pode criar (pré-login), auth gerencia
    match /requests/{id} {
      allow create: if true;
      allow read, write: if request.auth != null;
    }

    // Audit log: apenas autenticados
    match /auditLog/{id} {
      allow read, write: if request.auth != null;
    }
  }
}
